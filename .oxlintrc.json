{
  // Strictest configuration that still makes sense for a Tauri 2 + React 19 + TypeScript app.
  // Philosophy: real bugs are errors, opinions live in `restriction` as warnings,
  // and formatting is owned by Prettier (so stylistic/format rules are switched off here).
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "promise",
    "node"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    // `restriction` rules ban otherwise-good language features (optional chaining,
    // nullish coalescing, async/await...). They only make sense per-project, so we
    // opt out globally and re-enable individual rules here if ever needed.
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    // ---- Deliberately off: formatting is Prettier's job ----
    "import/newline-after-import": "off",
    "import/consistent-type-specifier-style": "off",
    "sort-imports": "off",

    // ---- Deliberately off: wrong or obsolete for React 19 + bundler ----
    "react/react-in-jsx-scope": "off",
    "react/jsx-filename-extension": "off",
    "react/jsx-no-literals": "off",
    "react/jsx-max-depth": "off",
    "react/jsx-props-no-spreading": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "unicorn/filename-case": "off",
    "unicorn/prefer-query-selector": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/prefer-string-replace-all": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "import/group-exports": "off",
    "import/no-default-export": "off",
    "import/prefer-default-export": "off",
    "import/no-named-export": "off",
    "import/no-nodejs-modules": "off",
    "import/no-unassigned-import": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "oxc/no-async-await": "off",

    // ---- Deliberately off: impractical for this codebase ----
    "import/exports-last": "off",
    "import/max-dependencies": "off",
    "unicorn/prefer-spread": "off",
    "unicorn/prefer-code-point": "off",
    "unicorn/consistent-function-scoping": "off",
    "eslint/prefer-destructuring": "off",
    "eslint/prefer-arrow-callback": "off",
    "unicorn/no-nested-ternary": "off",
    "unicorn/numeric-separators-style": "off",
    "unicorn/prefer-at": "off",
    "unicorn/catch-error-name": "off",
    "unicorn/no-array-sort": "off",
    "promise/prefer-await-to-then": "off",
    "promise/always-return": "off",
    "eslint/init-declarations": "off",
    "react/hook-use-state": "off",
    "react/jsx-no-constructed-context-values": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react/set-state-in-effect": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "typescript/consistent-indexed-object-style": "off",
    "import/no-namespace": "off",
    "react/no-array-index-key": "off",
    "react/display-name": "off",
    "eslint/arrow-body-style": "off",
    "react/function-component-definition": "off",

    // ---- Deliberately off: stylistic opinions that fight conventions ----
    "no-underscore-dangle": "off",
    "no-magic-numbers": "off",
    "no-undefined": "off",
    "no-null": "off",
    "no-ternary": "off",
    "no-continue": "off",
    "no-inline-comments": "off",
    "no-warning-comments": "off",
    "sort-keys": "off",
    "func-style": "off",
    "id-length": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-statements": "off",
    "max-depth": "off",
    "max-params": "off",
    "max-nested-callbacks": "off",
    "no-plusplus": "off",
    "one-var": "off",
    "no-else-return": "off",
    "no-nested-ternary": "off",
    "prefer-named-capture-group": "off",
    "require-unicode-regexp": "off",
    "capitalized-comments": "off",
    "no-use-before-define": "off",

    // ---- Kept strict, with practical allowances ----
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "typescript/consistent-type-definitions": ["error", "type"],
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    "import/no-duplicates": ["error", { "prefer-inline": false }],
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "error",
    "prefer-template": "error",
    "no-param-reassign": "error",
    "react/jsx-no-target-blank": "error",
    "react/no-array-index-key": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/no-autofocus": "error",
    "import/no-cycle": "warn"
  },
  "overrides": [
    {
      // Build/config files run in Node, not the browser.
      "files": ["vite.config.ts", "*.config.*"],
      "env": { "browser": false, "node": true }
    },
    {
      // Ambient/infra files have no runtime imports.
      "files": ["**/*.d.ts"],
      "rules": {
        "import/unambiguous": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "src-tauri/target/**", "src-tauri/gen/**", "node_modules/**"]
}
