{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-resource-history",
    "allow-get-processes",
    "allow-set-resource-streaming",
    "allow-thermal-history",
    "allow-recheck-thermals",
    "allow-power-history",
    "allow-list-power-plans",
    "allow-set-power-plan",
    "allow-get-display-brightness",
    "allow-set-display-brightness",
    "allow-get-game-mode",
    "allow-set-game-mode",
    "allow-get-hags",
    "allow-set-hags",
    "allow-get-windows-updates-paused",
    "allow-set-windows-updates-paused",
    "allow-get-startup-apps",
    "allow-disable-startup-app",
    "allow-enable-startup-app",
    "allow-toggle-startup-file",
    "allow-get-power-timeouts",
    "allow-set-power-timeouts",
    "allow-get-fast-startup",
    "allow-set-fast-startup",
    "allow-logs-snapshot",
    "allow-logs-bitlocker",
    "allow-memory-conversation-create",
    "allow-memory-conversation-list",
    "allow-memory-conversation-get",
    "allow-memory-conversation-delete",
    "allow-memory-conversation-archive",
    "allow-memory-conversation-touch",
    "allow-memory-message-append",
    "allow-memory-message-list",
    "allow-memory-message-delete",
    "allow-memory-fact-upsert",
    "allow-memory-fact-list",
    "allow-memory-fact-delete",
    "allow-memory-fact-clear",
    "allow-memory-search-index-upsert",
    "allow-memory-search-index-delete",
    "allow-memory-search",
    "allow-memory-stats",
    "allow-memory-clear-all",
    "allow-openrouter-chat"
  ]
}
