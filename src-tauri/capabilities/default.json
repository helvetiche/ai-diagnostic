{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-resource-history",
    "allow-get-processes",
    "allow-set-resource-streaming",
    "allow-thermal-history",
    "allow-recheck-thermals",
    "allow-power-history",
    "allow-list-power-plans",
    "allow-set-power-plan",
    "allow-get-power-timeouts",
    "allow-set-power-timeouts",
    "allow-get-fast-startup",
    "allow-set-fast-startup"
  ]
}
